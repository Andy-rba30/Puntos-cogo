<Window x:Class="PlanimetriaCogo.UI.ClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planimetría: clasificación de descripciones"
        Width="980" Height="620" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8">
            Revise a qué código destino va cada descripción encontrada en los puntos. Nada se modifica en el dibujo:
            el mapa es interno. Las filas sin código destino no se dibujan y se reportan como "sin resolver".
            La capa de las líneas con lados recibe el sufijo -IZQ / -DER al dibujar.
        </TextBlock>

        <DataGrid Grid.Row="1" x:Name="RowsGrid" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Sel." Width="40"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Descripción original" Width="160" IsReadOnly="True"
                                    Binding="{Binding Original}" />
                <DataGridTextColumn Header="Cantidad" Width="70" IsReadOnly="True"
                                    Binding="{Binding Count}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Código destino" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DestinationCode}" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="Text" Value="(sin resolver)" />
                                                <Setter Property="Foreground" Value="#B00020" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding DataContext.AvailableCodes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding DestinationCode, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tipo" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding KindLabel}" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.KindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding KindLabel, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Por lado" Width="65"
                                        Binding="{Binding SplitBySide, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Capa" Width="*" Binding="{Binding LayerBase, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Color (ACI)" Width="80" Binding="{Binding ColorIndex, UpdateSourceTrigger=LostFocus}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Sugerir similares" Padding="10,4" Margin="0,0,8,0"
                    ToolTip="Agrupa descripciones parecidas (mayúsculas, errores de tipeo, prefijos) y propone un código destino común"
                    Click="SuggestButton_Click" />
            <TextBlock DockPanel.Dock="Left" Text="Código:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox DockPanel.Dock="Left" Width="140" IsEditable="True"
                      ItemsSource="{Binding AvailableCodes}"
                      Text="{Binding UnifyCode, UpdateSourceTrigger=PropertyChanged}" />
            <Button DockPanel.Dock="Left" Content="Unificar selección" Padding="10,4" Margin="8,0,0,0"
                    ToolTip="Asigna el código indicado a las filas marcadas en la columna Sel. (o a las filas seleccionadas en la tabla)"
                    Click="UnifyButton_Click" />
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold" Text="{Binding Summary}" />
            <TextBlock Margin="0,4,0,0" Foreground="#555555" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Dibujar" Width="110" Padding="0,5" Margin="0,0,8,0" IsDefault="True"
                    IsEnabled="{Binding CanDraw}" Click="DrawButton_Click" />
            <Button Content="Cancelar" Width="110" Padding="0,5" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
