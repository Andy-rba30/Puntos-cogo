<Window x:Class="PlanimetriaCogo.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planimetría: parámetros"
        Width="640" SizeToContent="Height" MinWidth="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <GroupBox Header="Eje y lado">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Distancia máxima al eje, offsetMax (m):" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OffsetMax, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="#666" Text="Más lejos, el punto se descarta y se reporta. 0 = sin límite." />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Tolerancia sobre el eje, tolEje (m):" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AxisTolerance, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="#666" Text="Más cerca, el lado es indeterminado (salvo lado escrito en la descripción)." />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Paso de muestreo del eje (m):" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AxisSampleStep, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="#666" Text="Para hallar todas las proyecciones candidatas en curvas de vuelta." />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Código del eje (eje desde puntos):" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AxisCode, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="3" Grid.Column="2" Margin="8,2,0,2" IsChecked="{Binding KeepGeneratedAxis}" Content="Conservar el eje generado (dibujarlo como Polyline3d)" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Capa del eje generado:" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding GeneratedAxisLayer, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Orden y reglas de corte">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Orden dentro de cada grupo:" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding OrderLabel}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Distancia máxima entre consecutivos, distMax (m):" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DistMax, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="#666" Text="0 = sin límite." />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Salto máximo de progresiva (m):" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StationGapMax, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,0,0" Foreground="#666" Text="Corta entre pasadas distintas del eje. 0 = sin límite." />

                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" IsChecked="{Binding UseDescriptionMarks}"
                          Content="Interpretar marcas en la descripción (lado explícito, inicio y fin de línea)" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Marcas de inicio de línea:" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StartMarksText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseDescriptionMarks}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="Marcas de fin de línea:" />
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EndMarksText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseDescriptionMarks}" />
                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="Marcas de lado izquierdo:" />
                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LeftMarksText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseDescriptionMarks}" />
                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Label}" Text="Marcas de lado derecho:" />
                <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RightMarksText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseDescriptionMarks}" />

                <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" IsChecked="{Binding SplitSeries}"
                          Content="Sufijo numérico de serie (CUNETA1, CUNETA2) produce líneas distintas" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Acciones sobre el dibujo (apagadas por defecto: el plugin no deja rastro salvo las líneas)">
            <StackPanel>
                <CheckBox IsChecked="{Binding MovePointObjectsToLayer}" Content="Mover los puntos de tipo Punto a la capa indicada en su fila" />
                <CheckBox IsChecked="{Binding UpdateDescriptionsInDrawing}" Content="Actualizar las descripciones de los puntos con el código destino (conserva marcas y series)" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Reporte y capas">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding ReportToFile}" Content="Guardar el reporte en archivos .txt y .csv" />
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Carpeta del reporte (vacío = carpeta del DWG):" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReportFolder, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Prefijos de capa (líneas / puntos):" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="90" Text="{Binding LineLayerPrefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="90" Margin="8,2,0,2" Text="{Binding PointLayerPrefix, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Sufijos de lado (izquierda / derecha):" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="90" Text="{Binding LeftLayerSuffix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="90" Margin="8,2,0,2" Text="{Binding RightLayerSuffix, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Restablecer valores por defecto" Padding="10,4" Click="ResetButton_Click" />
            <Button DockPanel.Dock="Left" Content="Abrir carpeta de configuración" Padding="10,4" Margin="8,0,0,0" Click="OpenFolderButton_Click"
                    ToolTip="{Binding ConfigFolder}" />
            <Button DockPanel.Dock="Right" Content="Cancelar" Width="100" Padding="0,5" IsCancel="True" Click="CancelButton_Click" />
            <Button DockPanel.Dock="Right" Content="Aceptar" Width="100" Padding="0,5" Margin="0,0,8,0" IsDefault="True" Click="AcceptButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
